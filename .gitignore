wallet/
Wallet_*/
*wallet*.zip
cwallet.sso
ewallet.p12
tnsnames.ora
sqlnet.ora
ojdbc.properties
keystore.jks
truststore.jks

# Cualquier properties local con credenciales reales
application-local.properties
*-secrets.properties
.env

